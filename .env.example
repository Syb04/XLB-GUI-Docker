# Copy to .env and restart with start-docker.ps1 -Gpu -LocalData.
# Acceptance limits only; they do not guarantee solver RAM/VRAM capacity.
XLB_MAX_TOTAL_CELLS=10000000
XLB_MAX_AXIS_CELLS=1024
XLB_MAX_BOUNDARY_LINK_MIB=512
# auto: CUDA uses device thermal/LES/properties; CPU uses NumPy reference.
# reference: retain the old host thermal path for controlled comparisons.
XLB_COMPUTE_BACKEND=auto
